{
  "package": "anshun_monthly",
  "version": "1.0.0",
  "data_contract": {
    "sheet_index": 3,
    "required_columns": ["标题", "舆情调性"],
    "summary_columns": ["摘要", "原文内容"],
    "column_map": {
      "标题": "title", "发布时间": "published", "来源信息": "source",
      "作者": "author", "作者Id": "source_id", "事件分类": "category",
      "网址": "url", "媒体环节": "platform", "媒体属性": "media_attribute",
      "媒体级别": "media_level", "舆情调性": "sentiment", "是否预警": "warning"
    },
    "dedup": { "threshold": 0.65, "candidate_floor_ratio": 0.6 }
  },
  "vocabulary": {
    "localities": {
      "西秀区": ["西秀区"], "平坝区": ["平坝区"], "普定县": ["普定县"],
      "镇宁自治县": ["镇宁"], "关岭自治县": ["关岭"], "紫云自治县": ["紫云"],
      "黄果树旅游区": ["黄果树"], "安顺经开区": ["经开区", "开发区"]
    },
    "cluster_terms": {
      "交通管理": ["交通","公交","停车","道路","司机","车辆","驾考"],
      "文化旅游": ["景区","游客","黄果树","旅游","门票","民宿"],
      "社会民生": ["物业","供水","停水","工资","住房","社保","房产","首付","欠薪"],
      "市场监管": ["商家","消费","价格","退货","商品","食品","退款","餐饮","汉堡","售后"],
      "社会治安": ["盗窃","诈骗","治安","报警","殴打","寻人","失踪"],
      "安全生产": ["火灾","消防","矿井","生产安全","爆炸"],
      "教育管理": ["学校","学生","教师","校园","考试"],
      "医疗卫生": ["医院","医生","治疗","医疗","药品"],
      "环境保护": ["污染","排污","环保","河流","垃圾"],
      "城市管理": ["城管","违建","市容","环卫"],
      "执政形象": ["干部","政务","公职","行政执法","作风"],
      "自然灾害": ["洪灾","洪水","地震","滑坡","泥石流","暴雨"]
    }
  },
  "charts": [
    {
      "id": "sentiment",
      "title": "舆情调性分布",
      "draft_title": "舆情情绪分布（原始记录）",
      "final_title": "舆情调性分布",
      "family": "pie",
      "style": "pie",
      "binding": { "source": "metrics.sentiment" },
      "unit": "条",
      "scope": "all_records",
      "axis_label": "调性"
    },
    {
      "id": "daily",
      "title": "每日信息量",
      "draft_title": "每日信息量（原始记录）",
      "final_title": "每日舆情信息量",
      "family": "line",
      "style": "line",
      "binding": { "source": "metrics.daily_count" },
      "unit": "条",
      "scope": "all_records",
      "axis_label": "日期"
    },
    {
      "id": "platform",
      "title": "传播平台分布",
      "draft_title": "媒体环节分布（原始记录）",
      "final_title": "传播平台分布",
      "family": "pie",
      "style": "pie",
      "binding": { "source": "metrics.platform" },
      "unit": "条",
      "scope": "all_records",
      "axis_label": "传播平台"
    },
    {
      "id": "theme",
      "title": "事件分类",
      "draft_title": "敏感及负面并集主题候选分布",
      "final_title": "已确认事件分类",
      "family": "bar",
      "style": "bar",
      "binding": { "source": "theme_clusters.groups" },
      "unit": "件",
      "scope": "confirmed_events",
      "axis_label": "事件分类"
    },
    {
      "id": "locality",
      "title": "事件涉及属地",
      "draft_title": "敏感及负面并集属地候选分布",
      "final_title": "事件涉及属地（跨区及不明单列）",
      "family": "barh",
      "style": "barh",
      "binding": { "source": "locality.items" },
      "unit": "件",
      "scope": "confirmed_events",
      "axis_label": "属地",
      "locality_basis": "冻结属地识别的唯一候选；跨区及不明单列"
    }
  ]
}
