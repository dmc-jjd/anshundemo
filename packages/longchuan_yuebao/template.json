{
  "package": "longchuan_yuebao",
  "version": "1.0.0",
  "writer_slots": [
    "b5_sensitive_events",
    "b8_top_info",
    "b21_gov_titles",
    "b21_top_gov_title",
    "b22_central_examples",
    "b22_leading_level",
    "b22_provincial_examples",
    "b22_local_examples",
    "b25_event_list",
    "b27_focus_title1",
    "b28_focus_intro1",
    "numbered_items_1",
    "b34_focus_title2",
    "b35_focus_intro2",
    "numbered_items_2",
    "b42_case_report",
    "b43_case_analysis",
    "b44_case_suggestion"
  ],
  "section_two": {
    "field_roles": {
      "numbered_items_1": "general",
      "numbered_items_2": "general"
    }
  },
  "data_contract": {
    "sheet_index": 1,
    "required_columns": [
      "标题",
      "舆情调性"
    ],
    "summary_columns": [
      "摘要"
    ],
    "column_map": {
      "标题": "title",
      "发布时间": "published",
      "来源信息": "source",
      "作者": "author",
      "作者Id": "source_id",
      "事件分类": "category",
      "网址": "url",
      "媒体环节": "platform",
      "媒体属性": "media_attribute",
      "媒体级别": "media_level",
      "舆情调性": "sentiment",
      "是否预警": "warning"
    },
    "dedup": {
      "threshold": 0.65,
      "candidate_floor_ratio": 0.6,
      "merge_rounds": 2,
      "merge_threshold": 0.5
    },
    "sentiment": {
      "field": "sentiment",
      "values": [
        "正面",
        "中性",
        "负面"
      ],
      "scopes": {
        "negative": {
          "contains": [
            "负"
          ]
        },
        "positive": {
          "values": [
            "正面"
          ]
        },
        "neutral": {
          "values": [
            "中性"
          ]
        }
      }
    },
    "warning": {
      "field": "warning",
      "truth": [
        "是",
        "已预警",
        "1",
        "true",
        "TRUE",
        "预警"
      ],
      "scopes": {
        "warning": {
          "warning_truth": true,
          "require_truth_present": true
        },
        "negative_warning": {
          "all": [
            {
              "warning_truth": true
            },
            {
              "contains": [
                "负"
              ]
            }
          ],
          "require_truth_present": true
        },
        "negative_or_warning": {
          "any": [
            {
              "contains": [
                "负"
              ]
            },
            {
              "warning_truth": true
            }
          ]
        }
      }
    }
  },
  "vocabulary": {
    "localities": {
      "龙川县": [
        "龙川县",
        "我县"
      ]
    },
    "cluster_terms": {
      "未分类": [
        "未分类"
      ]
    }
  },
  "charts": [
    {
      "id": "daily",
      "title": "舆情信息走势",
      "draft_title": "每日信息量（原始记录）",
      "final_title": "舆情信息走势",
      "family": "line",
      "style": "line",
      "binding": {
        "source": "metrics.daily_count"
      },
      "unit": "条",
      "scope": "all_records",
      "axis_label": "日期"
    },
    {
      "id": "platform",
      "title": "信息平台来源分布",
      "draft_title": "媒体环节分布（原始记录）",
      "final_title": "信息平台来源分布",
      "family": "pie",
      "style": "pie",
      "binding": {
        "source": "metrics.platform"
      },
      "unit": "条",
      "scope": "all_records",
      "axis_label": "传播平台"
    },
    {
      "id": "source",
      "title": "信源分布",
      "draft_title": "来源信息分布（原始记录）",
      "final_title": "信源分布",
      "family": "pie",
      "style": "pie",
      "binding": {
        "source": "metrics.source"
      },
      "unit": "条",
      "scope": "all_records",
      "axis_label": "信源"
    }
  ],
  "calculation_contexts": {
    "b21_top_gov_count": {
      "title_field": "b21_top_gov_title",
      "list_field": "b21_gov_titles"
    }
  }
}
