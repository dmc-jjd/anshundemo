  "section_two": {
    "field_roles": {
      "numbered_items_1": "general",
      "numbered_items_2": "general"
    }
  },
  "data_contract": {
    "sheet_index": 1,
    "required_columns": [
      "标题",
      "舆情调性"
    ],
    "summary_columns": [
      "摘要"
    ],
    "column_map": {
      "标题": "title",
      "发布时间": "published",
      "来源信息": "source",
      "作者": "author",
      "作者Id": "source_id",
      "事件分类": "category",
      "网址": "url",
      "媒体环节": "platform",
      "媒体属性": "media_attribute",
      "媒体级别": "media_level",
      "舆情调性": "sentiment",
      "是否预警": "warning"
    },
    "dedup": {
      "threshold": 0.65,
      "candidate_floor_ratio": 0.6,
      "merge_rounds": 2,
      "merge_threshold": 0.5
    },
    "sentiment": {
      "field": "sentiment",
      "values": [
        "正面",
        "中性",
        "负面"
      ],
      "scopes": {
        "negative": {
          "contains": [
            "负"
          ]
        },
        "positive": {
          "values": [
            "正面"
          ]
        },
        "neutral": {
          "values": [
            "中性"
          ]
        }
      }
    },
    "warning": {
      "field": "warning",
      "truth": [
        "是",
        "已预警",
        "1",
        "true",
        "TRUE",
        "预警"
      ],
      "scopes": {
        "warning": {
          "warning_truth": true,
          "require_truth_present": true
        },
        "negative_warning": {
          "all": [
            {
              "warning_truth": true
            },
            {
              "contains": [
                "负"
              ]
            }
          ],
          "require_truth_present": true
        },
        "negative_or_warning": {
          "any": [
            {
              "contains": [
                "负"
              ]
            },
            {
              "warning_truth": true
            }
          ]
        }
      }
    }
  },
